---
import { Image } from "astro:assets";
import Figma from "../assets/images/figma.webp";
import Affinity from "../assets/images/affinity.webp";
import Davinci from "../assets/images/davinci.webp";
import AstroLogo from "../assets/images/astro.webp";
import TailwindLogo from "../assets/images/tailwind.webp";
import PocketbaseLogo from "../assets/images/pocketbase.webp";
import HTMLLogo from "../assets/images/html5.webp";
import CSSLogo from "../assets/images/css.webp";
import JavaScriptLogo from "../assets/images/js.webp";
---

<section>
    <div class="flex items-center justify-between gap-4 py-4">
        <p class="ml-5">À l'atelier / Mes outils</p>
        <p class="text-primary">04/05</p>
    </div>
    <div class="ligne"></div>
    <h2 class="font-title text-mobile2 sm:text-4xl lg:text-h2d ml-4 sm:ml-8 lg:ml-15">
        Pour créer
    </h2>
    <div class="grid grid-cols-1 gap-4 p-4 sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex items-center">
            <Image src={Figma} alt="Logo figma" class="w-20" />
            <p class="p-2">
                Figma
                <br /> Concevoir & prototyper
            </p>
        </div>
        <div class="flex items-center">
            <Image src={Affinity} alt="Logo Affinity " class="w-20" />
            <p class="p-2">
                Affinity
                <br />Dessiner & mise en page
            </p>
        </div>
        <div class="flex items-center">
            <Image src={Davinci} alt="Logo Davinci resolve" class="w-20" />
            <p class="p-2">
                Davinci resolve
                <br /> Montages vidéos
            </p>
        </div>
        <div class="flex items-center">
            <Image src={AstroLogo} alt="Logo Davinci resolve" class="w-20" />
            <p class="p-2">
                Astro
                <br /> Développer pour le web
            </p>
        </div>
        <div class="flex items-center">
            <Image src={TailwindLogo} alt="Logo Tailwind" class="w-20" />
            <p class="p-2">
                Tailwind
                <br />Couleurs & styles
            </p>
        </div>
        <div class="flex items-center">
            <Image src={PocketbaseLogo} alt="Logo Pocketbase" class="w-20" />
            <p class="p-2">
                Pocketbase
                <br />Base de données
            </p>
        </div>
        <div class="flex items-center">
            <Image src={HTMLLogo} alt="Logo HTML" class="w-20" />
            <p class="p-2">
                HTML
                <br />Développer pour le web
            </p>
        </div>
        <div class="flex items-center">
            <Image src={CSSLogo} alt="Logo CSS" class="w-20" />
            <p class="p-2">
                CSS
                <br />Couleurs & styles
            </p>
        </div>
        <div class="flex items-center">
            <Image src={JavaScriptLogo} alt="Logo JavaScript" class="w-30" />
            <p class="p-2">
                JavaScript
                <br />Animation
            </p>
        </div>
    </div>
</section>

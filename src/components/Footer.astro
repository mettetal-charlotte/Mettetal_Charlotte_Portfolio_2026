            <p class="lg:col-start-2 lg:col-span-2">Charlotte Mettetal</p>
            <ul class="lg:col-start-5 lg:col-span-3">
                <li><a href="/mentions_legales">Mentions légales</a></li>
                <li>Tous droit réservés</li>
            </ul>
            <p class="lg:col-start-9 lg:col-span-3">Retrouvez moi</p>
            <ul class="flex items-center gap-4 lg:col-start-9">
                <li><Linkedin class="h-6 w-auto m-2 col-start-9" /></li>
                <li><Behance class="h-6 w-auto m-2" /></li>
            </ul>
        </div>
    </nav>
</footer>

---
import { Image } from "astro:assets";
import liseMeitner from "../assets/images/lisemeitner.webp";
import FlecheDroite from "../assets/icon/fleche_droite.svg";
---

<section class="min-w-0">
    <div class="mx-auto max-w-xl">
        <Image src={liseMeitner} alt="Lise Meitner" class="mx-auto w-full max-w-80" />
        <p class="text-primary text-body4d p-2">
            01- Site web • Projet individuel
        </p>
        <p class="text-2xl sm:text-body1d p-2">Lise Meitner & l'effet Matilda</p>
        <p class="p-2">
            L'histoire d'une scientifique invisibilisée et d'un phénomène très
            répendu.
            <br />De la conception au développement
        </p>
        <div class="flex flex-wrap items-center gap-3 p-2 justify-between">
            <p class="text-primary text-body4d">HTML / CSS</p>
            <a href="/projet1" class="inline-flex items-center gap-2 justify-center">
                <span>Découvrir le projet</span>
                <FlecheDroite/>
            </a>
        </div>
    </div>
</section>

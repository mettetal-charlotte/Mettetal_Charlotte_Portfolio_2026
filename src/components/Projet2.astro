---
import { Image } from "astro:assets";
import LSF from "../assets/images/lsf.webp";
import FlecheDroite from "../assets/icon/fleche_droite.svg";
---

<section class="ml-20">
    <div>
        <Image
            src={LSF}
            alt="Signes de la langue des signes française"
            class="mx-20 w-80"
        />
        <p class="text-primary text-body4d p-2">
            02 - Application • Projet à 3
        </p>
        <p class="text-body1d p-2">Tacita</p>
        <p class="p-2">
            Apprendre la langue des signes française grâce à des mini-jeux,
            c'est possible
            <br /> Un projet réalisé avec Luna Gouraud et Yanis Chouhib.
        </p>
        <div class="flex items-center p-2 justify-between">
            <p class="text-primary">Astro / Tailwind / Pocketbase</p>
            <a href="/projet2" class="inline-flex items-center gap-2 justify-center">
                <span>Découvrir le projet</span>
                <FlecheDroite />
            </a>
        </div>
    </div>
</section>
